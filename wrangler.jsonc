{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "repo-helper",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-24",
  "observability": {
    "enabled": true
  },
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "producers": [
      {
        "queue": "repo-openai-jobs",
        "binding": "QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "repo-openai-jobs",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 10,
        "dead_letter_queue": "my-queue-dlq"
      }
    ]
  }
}
